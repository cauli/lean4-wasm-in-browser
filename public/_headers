# Cloudflare Pages response headers.
#
# The heavy immutable assets (lean.js, lean.wasm, oleans) live in R2, not here —
# this only tunes the small app shell that Pages serves.

# The manifest is regenerated whenever the WASM artifact changes, so keep its
# cache short so an artifact swap propagates quickly.
/lean-manifest.json
  Cache-Control: public, max-age=300

# The worker iframes are tiny and may change with app logic; keep them fresh.
/lean-worker-persistent.html
  Cache-Control: public, max-age=300
/lean-worker-simple.html
  Cache-Control: public, max-age=300
