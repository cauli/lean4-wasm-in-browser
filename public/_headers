# Cloudflare Pages response headers.

# Cross-origin isolation. This is a pthread build with SHARED WebAssembly
# memory, which requires SharedArrayBuffer — only available in a
# cross-origin-isolated context. Must be present on the top-level document AND
# the worker iframes. Assets served from R2 by the Pages Function are
# same-origin, so they need no CORP under `require-corp`.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# The manifest is regenerated whenever the WASM artifact changes; keep it short
# so an artifact swap propagates quickly.
/lean-manifest.json
  Cache-Control: public, max-age=300

# The worker iframes are tiny and change with app logic; keep them fresh.
/lean-worker-persistent.html
  Cache-Control: public, max-age=300
/lean-worker-simple.html
  Cache-Control: public, max-age=300

# The Real Analysis manifest and numbered packs move together in an atomic
# Pages deployment. Keep them revalidating so a browser never pins numbered
# pack URLs across a later Mathlib/course rebuild.
/lean-wasm/real-analysis-layer.json
  Cache-Control: public, max-age=300, must-revalidate
/lean-wasm/real-analysis-lib/*
  Cache-Control: public, max-age=300, must-revalidate
