{
  "name": "lean4-wasm-test",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "import:nng4": "node scripts/import-nng4.mjs",
    "import:real-analysis": "node scripts/import-real-analysis-game.mjs",
    "port:real-analysis": "node scripts/port-real-analysis-lean.mjs",
    "package:real-analysis": "node scripts/package-real-analysis-layer.mjs",
    "build:manifold-course": "bash scripts/build-manifold-course.sh",
    "verify:manifold-references": "node scripts/verify-manifold-references.mjs",
    "package:manifold": "node scripts/package-real-analysis-layer.mjs /tmp/manifold-mathlib4 lean public/lean-wasm/manifold-lib public/lean-wasm/manifold-layer.json public/lean-wasm/lean-lib public/lean-wasm/lean-lib-files.json ../lean4-433/src lean ManifoldAdventure.BrowserBase public/lean-wasm/real-analysis-layer.json",
    "gen-lib-files": "node scripts/gen-lib-files.mjs public/lean-wasm/lean-lib public/lean-wasm/lean-lib-files.json",
    "gen-manifest": "node scripts/gen-manifest.mjs ../lean4/src public/lean-manifest.json public/lean-wasm/lean-lib",
    "compress-oleans": "node scripts/compress-oleans.mjs public/lean-wasm/lean-lib",
    "test": "node --test tests/*.test.mjs",
    "test:nng": "node --test --test-name-pattern='^NNG4 matrix' tests/playground.test.mjs",
    "test:manifold": "UPDATE_MANIFOLD_MATRIX=1 playwright test e2e/manifold-matrix.spec.ts",
    "test:real-analysis": "UPDATE_REAL_ANALYSIS_MATRIX=1 playwright test e2e/real-analysis-matrix.spec.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:fetch": "node tests/fetch-artifacts.mjs"
  },
  "dependencies": {
    "@leanprover/unicode-input": "^0.1.11",
    "fflate": "^0.8.2",
    "katex": "^0.18.1",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^5.1.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.2.4"
  },
  "overrides": {
    "dompurify": "3.4.12"
  }
}
